# Copy to .env and fill in local values. Never commit real secrets.

NODE_ENV=development
APP_NAME=Industrial ERP
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=erp
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=erp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erp:change_me_postgres@localhost:5432/erp?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Auth / cookies
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Initial administrator bootstrap (disabled after first Super Administrator exists)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_temporary_password
BOOTSTRAP_ADMIN_NAME=System Administrator

# Registration policy: open | invite_only | approval_required
REGISTRATION_POLICY=approval_required
REQUIRE_EMAIL_VERIFICATION=true

# Mail (adapter; console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# Object storage (S3-compatible / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio
S3_BUCKET=erp-documents
S3_FORCE_PATH_STYLE=true

# E-invoicing (provider adapters; sandbox credentials only in non-production)
EINVOICE_PROVIDER=sandbox
EINVOICE_SANDBOX=true
EINVOICE_API_URL=
EINVOICE_API_KEY=

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
